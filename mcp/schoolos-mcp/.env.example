# Copy to .env and fill in. .env is git-ignored. Never commit real passwords.

# Your only Supabase project is the live one, so the server needs this opt-in and then runs READ ONLY.
SUPABASE_URL=https://hgoasuqnuhltxocbcjnr.supabase.co
PRODUCTION_SUPABASE_URL=https://hgoasuqnuhltxocbcjnr.supabase.co
ALLOW_PRODUCTION=yes

# Supabase dashboard > Project Settings > API: the anon / publishable key. NOT the service_role / secret key.
SUPABASE_ANON_KEY=

# Where the app runs (npm run dev)
APP_BASE_URL=http://localhost:3000

# Test accounts. Use accounts in a school you treat as a test school. Leave a role blank to skip it.
TEST_PRINCIPAL_EMAIL=
TEST_PRINCIPAL_PASSWORD=
TEST_TEACHER_EMAIL=
TEST_TEACHER_PASSWORD=
TEST_BURSAR_EMAIL=
TEST_BURSAR_PASSWORD=
TEST_SECRETARY_EMAIL=
TEST_SECRETARY_PASSWORD=
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
TEST_PARENT_EMAIL=
TEST_PARENT_PASSWORD=
