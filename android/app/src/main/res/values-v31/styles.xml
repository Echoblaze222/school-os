<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12 (API 31+) replaced the old "just show this drawable as the
      window background" launch screen with a dedicated SplashScreen API.
      Setting android:background=@drawable/splash on a Theme.SplashScreen
      parent (as values/styles.xml does, for pre-31 devices) is ignored on
      31+: the system instead falls back to rendering the app's launcher
      icon at a small fixed size on a plain default-colored background -
      exactly the "tiny icon floating in empty dark space" look reported.

      Fixed by setting the dedicated windowSplashScreen* attributes:
        - background: white, to match the official lockup (below), whose
          "OS" wordmark is a dark maroon meant for a light surface
        - icon: the full launcher icon (burgundy square + diamonds) - not
          the transparent foreground-only layer, which would vanish
          against the white background below
        - brandingImage: the full "[diamond] OS" lockup, shown near the
          bottom - this is what that attribute exists for (a secondary
          wordmark below the icon), not a random custom slot.
          NOTE: unlike the other three items here, this one needs the
          android: prefix. background/icon/postSplashScreenTheme are
          custom attrs backported by AndroidX's core-splashscreen compat
          library (so they resolve without a namespace prefix down to
          API 21) - but brandingImage was never included in that compat
          surface, so it only exists as the real platform attribute.
          Bare "windowSplashScreenBrandingImage" fails resource linking
          with "attr ... not found" since nothing declares it as a
          local/compat attr.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>